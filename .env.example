# ==============================================
# API Configuration
# ==============================================

# Backend API Base URL
# Default: http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# Use Next.js proxy to bypass CORS (development only)
# Set to "true" to use /api proxy, "false" to call backend directly
# Default: false
NEXT_PUBLIC_USE_PROXY=false

# ==============================================
# Application Configuration
# ==============================================

# Base URL of this frontend application
# Used for SSO callbacks and redirects
NEXT_PUBLIC_BASE_URL=http://localhost:3001

# ==============================================
# Authentication / SSO Configuration
# ==============================================

# Application Key for Unila SSO Integration
# Contact your system administrator for this key
NEXT_PUBLIC_APP_KEY=your_app_key_here

# ==============================================
# Optional: Development Configuration
# ==============================================

# Node Environment
NODE_ENV=development

# ==============================================
# Notes:
# ==============================================
# 1. Copy this file to .env.local for local development
# 2. Never commit .env.local to version control
# 3. Contact the backend team for the correct API_URL in production
# 4. NEXT_PUBLIC_* variables are exposed to the browser
